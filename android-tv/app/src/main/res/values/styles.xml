        <item name="windowSplashScreenAnimatedIcon">@drawable/brand_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Plys</item>
    </style>
    <style name="Theme.Plys" parent="android:style/Theme.Material.NoActionBar">
