# Host user mapping so files created by containers belong to the host user (`id -u` / `id -g`).
UID=1000
GID=1000

# Production (compose.prod.yaml, see the README)
# Host directory holding the videos, mounted read-only at /media in the API container.
POSTGRES_PASSWORD=change-me
# false over plain http; true behind an HTTPS reverse proxy.
COOKIE_SECURE=false
# Image version to run (a release such as 0.1.0, or latest).
# PLYS_VERSION=latest
# Hardware transcoding: stat -c %g /dev/dri/renderD128, then uncomment the devices lines in the compose file.
# RENDER_GID=
