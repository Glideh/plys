# Host user mapping so files created by containers belong to you (`id -u` / `id -g`).
UID=1000
GID=1000

# Production (compose.prod.yaml)
# Host directory holding your videos, mounted read-only at /media in the API container.
MEDIA_DIR=/path/to/videos
POSTGRES_PASSWORD=change-me
HTTP_PORT=8096
# false over plain http; true behind an HTTPS reverse proxy.
COOKIE_SECURE=false
# Image version to run (a release such as 1.2.3, or latest).
# PLYS_VERSION=latest
# Hardware transcoding, with compose.gpu.yaml: stat -c %g /dev/dri/renderD128
# RENDER_GID=
